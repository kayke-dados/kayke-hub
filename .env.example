# ---------------------------------------------------------------------------
# Público (pode ir para o navegador; nunca coloque segredos com VITE_)
# ---------------------------------------------------------------------------
# Quantidade de cursos concluídos, sempre na ordem de 1 a 10.
# 0 = nenhum; 10 = todos. Ausente ou inválido = 0.
VITE_CURSOS_CONCLUIDOS=0

# URL pública do site (usada em canonical, Open Graph e sitemap).
# Em produção, troque pelo domínio real da Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (necessário para a área administrativa real)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# E-mail do único administrador autorizado.
ADMIN_EMAIL=kayke0812@proton.me
